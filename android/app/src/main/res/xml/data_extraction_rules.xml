<?xml version="1.0" encoding="utf-8"?>
<!-- Setups and preferences are the user's work; carry them to a new phone. Share-sheet exports are temporary. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="desksetup.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="desksetup.db" />
    </device-transfer>
</data-extraction-rules>
